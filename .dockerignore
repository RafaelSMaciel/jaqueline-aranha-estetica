# Contexto do `docker build`: so o necessario para a imagem (codigo, requirements, front).
.git
.gitignore
.github
.gitattributes
.pre-commit-config.yaml
.gitleaks.toml

# ambientes, caches e bancos locais. `**/`: sem ele o padrao so casa na raiz do contexto
# (um __pycache__ ou sqlite dentro de aranha_estetica/ ia para a imagem)
.venv
venv/
env/
.cache/
**/__pycache__
**/*.py[cod]
.import_linter_cache/
.grimp_cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
**/*.sqlite3*

# Backups/dumps do Postgres (dado pessoal e de saude): nunca no git nem na imagem
**/*.dump*
**/*.backup
**/*.sql.gz

# segredos
.env
.env.*
!.env.example

# front: node_modules e o dist local (o stage `front` do Dockerfile gera o dist da imagem)
node_modules/
aranha_estetica/static/dist/

# runtime / editores / ferramentas
staticfiles/
media/
**/*.log
.DS_Store
.vscode/
.idea/
.claude/
.worktrees/
.playwright-mcp/
screenshots/

# documentacao e arquivos do repo que a imagem nao usa: testes (fixtures e dados ficticios) e os
# scripts de backup (rodam fora do Railway, com pg_dump e age)
docs/
aranha_estetica/tests/
scripts/
*.md
!README.md
.dockerignore
Dockerfile
docker-compose.yml
