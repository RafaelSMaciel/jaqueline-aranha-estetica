# Jaqueline Aranha Estética — variáveis de ambiente
# Dev local: copie para `.env` (DEBUG=True basta; o resto tem default).
# Produção (Railway): defina no serviço web. `manage.py check` lista o que falta
# em prod: avisos aranha.W001..W015 (W006 = nenhum ADMIN utilizável e W010 = termo
# LGPD/SAÚDE sem versão ativa, só com banco: `manage.py check --database default`) e
# erros aranha.E001..E004, que barram o pre-deploy (E001 = sem CHAVES_CIFRAGEM, E002 =
# sem Postgres, E003 = segredo fraco ou de exemplo, E004 = OTP_MAX_TENTATIVAS fora de 1..10).
# Só os settings (clinica/settings) leem estas variáveis; tests/infra/test_deploy.py confere
# que este arquivo lista todas elas.

# ═══════════════════════════════════════════════════════════════════
#  OBRIGATÓRIAS EM PRODUÇÃO
# ═══════════════════════════════════════════════════════════════════

# Vazia no dev local (DEBUG=True usa uma chave só de dev). Em prod/staging: 50+ caracteres
# aleatórios, nunca um valor de exemplo (aranha.E003). Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# DEBUG=True só em dev local. Em prod é sempre forçado para False (settings/prod.py).
DEBUG=True

# Cifragem em repouso do dado de saúde (prontuário, fichas, anotações) e do token OAuth do
# Google. OBRIGATÓRIA em prod (sem ela o check aranha.E001 barra o deploy). Gere com:
#   python manage.py gerar_chave_cifragem
# Várias chaves separadas por vírgula: a 1ª cifra, todas decifram (rotação: nova na frente +
# `python manage.py rotacionar_chave_cifragem` + tirar a antiga). PERDER A CHAVE = PERDER O
# PRONTUÁRIO: guarde uma cópia offline. Em dev, vazia = derivada da DJANGO_SECRET_KEY.
CHAVES_CIFRAGEM=

# Opcional: chave própria do HMAC dos códigos OTP (vazia = usa a DJANGO_SECRET_KEY).
# OTP_HMAC_KEY=

# Hosts aceitos (vírgula). O Railway acrescenta RAILWAY_PUBLIC_DOMAIN e o host
# do healthcheck (healthcheck.railway.app) automaticamente.
ALLOWED_HOSTS=127.0.0.1,localhost
# Origens CSRF. Em prod só as https valem (as http são descartadas); RAILWAY_PUBLIC_DOMAIN
# é acrescentado sozinho.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# URL pública absoluta, sem barra final — links de e-mail/WhatsApp/termos/JSON-LD.
# Sem ela, cai em https://$RAILWAY_PUBLIC_DOMAIN (ou localhost em dev).
SITE_URL=http://127.0.0.1:8000

# Postgres. No Railway NÃO vem sozinho: crie no serviço web a variável de referência
# DATABASE_URL=${{Postgres.DATABASE_URL}}. Prod/staging sem Postgres não sobe (aranha.E002).
# Vazio em dev = SQLite (db_dev.sqlite3), ou Postgres local por DB_ENGINE + DB_* abaixo.
# DATABASE_URL=postgres://user:pass@localhost:5432/aranha_estetica_dev
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=aranha_estetica_dev
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# Nome da conexão no pg_stat_activity e teto por statement em ms (0 desliga)
# DB_APPLICATION_NAME=shivazen
# DB_STATEMENT_TIMEOUT_MS=30000

# Token do cron externo: POST /cron/run/<job>/ com header X-Cron-Token (nunca ?token=).
# 32+ caracteres (aranha.E003). Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_TOKEN=
# Monitor dos jobs (healthchecks.io: https://hc-ping.com/<ping key>): avisa <url>/<job> a cada
# execução e <url>/<job>/fail na falha. Vazio = sem monitor.
# CRON_MONITOR_URL=

# SMS (OTP do agendamento, Meus Agendamentos, LGPD). Sem os dois, o envio falha
# fechado em prod e o site orienta o cliente a usar o WhatsApp.
ZENVIA_API_TOKEN=
ZENVIA_FROM=

# E-mail. Em prod, sem EMAIL_BACKEND nada é enviado (backend dummy, aviso
# aranha.W003); em dev o default é o console.
# O Railway Hobby bloqueia SMTP de saída: use um provedor HTTP pelo
# django-anymail (já no requirements). Backend + chave do provedor — só as
# chaves presentes vão para o anymail (aviso aranha.W011 se faltar a do backend):
#   anymail.backends.resend.EmailBackend   + RESEND_API_KEY
#   anymail.backends.brevo.EmailBackend    + BREVO_API_KEY
#   anymail.backends.sendgrid.EmailBackend + SENDGRID_API_KEY
#   anymail.backends.mailgun.EmailBackend  + MAILGUN_API_KEY (+ MAILGUN_SENDER_DOMAIN)
#   anymail.backends.postmark.EmailBackend + POSTMARK_SERVER_TOKEN
# Plano Pro (SMTP liberado): django.core.mail.backends.smtp.EmailBackend + EMAIL_HOST*.
# Ex. (Resend): EMAIL_BACKEND=anymail.backends.resend.EmailBackend + RESEND_API_KEY=re_...
EMAIL_BACKEND=
RESEND_API_KEY=
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_SENDER_DOMAIN=
# POSTMARK_SERVER_TOKEN=
# SMTP (só plano Pro do Railway)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Timeout (s) do SMTP e das chamadas HTTP do anymail
EMAIL_TIMEOUT=10
# Remetente: endereço de um domínio VERIFICADO no provedor (registros SPF/DKIM
# no DNS), ex.: "Jaqueline Aranha Estética <contato@seudominio.com.br>". O valor
# abaixo é só exemplo: com ele o provedor HTTP recusa tudo (aviso aranha.W011).
DEFAULT_FROM_EMAIL=noreply@clinica.com.br

# Admin criado/atualizado no pre-deploy (manage.py bootstrap_admin). Sem os dois
# o comando não cria nada e, se não houver nenhum ADMIN ativo com senha (a
# migration 0042 desliga a conta demo), escreve ERRO no log do deploy.
# PRÉ-REQUISITO do 1º deploy com as migrations novas. A senha passa pelos
# validadores do Django (mín. 10 caracteres, não comum/numérica). A senha de um
# admin existente só é trocada se a conta estava desativada ou com
# ADMIN_PASSWORD_RESET=true. ADMIN_EMAIL também recebe os alertas de NPS
# detrator (sem ele, vão para o CLINIC_EMAIL do Branding). Depois do 1º login o
# ADMIN cadastra o 2FA (QR na tela); sem acesso ao painel:
# `railway ssh` + `python manage.py setup_2fa <email>` (--force = reset completo
# do 2FA da conta). Conta desativada/rebaixada no painel com outro admin ativo
# NÃO é reativada pelo deploy (só com ADMIN_PASSWORD_RESET=true); reativar
# remove o 2FA antigo da conta. A senha fica em texto puro na env: depois do
# 1º deploy, apague ADMIN_PASSWORD do Railway.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=
ADMIN_PASSWORD_RESET=

# ═══════════════════════════════════════════════════════════════════
#  MARCA / CONTATOS (a tela Branding do painel tem precedência sobre a env)
#  Vazio = item escondido no site (nunca placeholder falso).
# ═══════════════════════════════════════════════════════════════════
CLINIC_NAME=Jaqueline Aranha Estética
CLINIC_SUBTITLE=
# E-mail de contato: canal do titular LGPD no site (aviso aranha.W007 se vazio)
CLINIC_EMAIL=
CLINIC_PHONE=
CLINIC_ADDRESS=
CLINIC_HOURS=
# Só dígitos, com DDI (ex.: 5517991234567)
WHATSAPP_NUMERO=
INSTAGRAM_URL=
THEME_COLOR=
# Política de privacidade (LGPD arts. 9 e 41): controlador e encarregado de dados.
# Obrigatórios no go-live (podem vir da tela Branding).
CLINIC_RAZAO_SOCIAL=
CLINIC_CNPJ=
ENCARREGADO_NOME=
ENCARREGADO_EMAIL=

# ═══════════════════════════════════════════════════════════════════
#  OPCIONAIS
# ═══════════════════════════════════════════════════════════════════

# dev | prod | staging. Vazio = dev local; prod quando RAILWAY_ENVIRONMENT_NAME existe.
# staging = ambiente de testes publicado (Railway "dev"): produção + travas (SMS só em log,
# e-mail/WhatsApp só p/ DESTINATARIOS_TESTE, noindex, seed --demo). dev no Railway derruba o boot
# (publicaria DEBUG=True). NUNCA importe este arquivo no Railway: ele é para o .env local.
# DJANGO_ENV=dev
# Ambiente de testes: só estes e-mails/celulares recebem mensagem (separados por vírgula)
# DESTINATARIOS_TESTE=voce@exemplo.com,17999990000
# Redirect p/ HTTPS em prod (default True)
USE_HTTPS=True
# Respeitar X-Forwarded-Host do proxy (prod sempre liga)
# USE_X_FORWARDED_HOST=True

# IP do cliente: header escrito pelo proxy de borda. Prod default HTTP_X_REAL_IP
# (Railway); vazio em dev = REMOTE_ADDR. Nunca usar X-Forwarded-For (forjável).
# CLIENT_IP_HEADER=HTTP_X_REAL_IP

# Gunicorn (Dockerfile/railway.json). Mantenha 1 worker sem REDIS_URL.
# Access log com tokens de link mágico redigidos (clinica/gunicorn_logger.py).
# WEB_CONCURRENCY=1
# WEB_THREADS=4
# WEB_TIMEOUT=120

# Sessão da equipe em prod: 8h deslizantes (segundos)
# SESSION_COOKIE_AGE=28800

# Cache/sessão compartilhados entre workers do gunicorn (opcional)
REDIS_URL=

# Captcha (Cloudflare Turnstile) no agendamento público. Com SMS real
# (ZENVIA_*) defina as duas: sem captcha poucos IPs esgotam a cota global de
# SMS e travam o agendamento online (aviso aranha.W009).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS — ajustes finos (defaults seguros)
# ZENVIA_API_URL=https://api.zenvia.com/v2/channels/sms/messages
# ZENVIA_WEBHOOK_SECRET=
# ZENVIA_ALLOWED_IPS=
# SMS_MAX_POR_HORA=3
# SMS_MAX_POR_IP_HORA=10
# SMS_MAX_GLOBAL_HORA=60
# true = só loga, não envia (dev/testes; nunca em prod)
# SMS_DEV_LOG_ONLY=

# OTP
# OTP_TTL_SEGUNDOS=600
# OTP_MAX_TENTATIVAS=5
# OTP_REENVIO_MINIMO_SEG=60

# WhatsApp Business API (Meta). Sem TOKEN + PHONE_ID o envio falha fechado.
WHATSAPP_TOKEN=
# ID do número no WhatsApp Business
WHATSAPP_PHONE_ID=
# Alias legado do ID (aceito se WHATSAPP_PHONE_ID estiver vazio)
# WHATSAPP_PHONE_NUMBER_ID=
# Webhook: VERIFY_TOKEN no handshake (GET; 32+ caracteres, aranha.E003) e APP_SECRET na
# assinatura X-Hub-Signature-256 (sem ele o webhook recusa tudo)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_URL=
# Versão da Graph API (padrão v23.0)
# WHATSAPP_API_VERSION=v23.0
# Nomes dos templates aprovados na Meta. O de lista de espera tem 4 parâmetros
# no corpo: nome, procedimento, data/hora, link.
# WHATSAPP_TEMPLATE_D1=confirmacao_d1
# WHATSAPP_TEMPLATE_NPS=nps_pos_atendimento
# WHATSAPP_TEMPLATE_LISTA_ESPERA=lista_espera_vaga

# Web Push (VAPID). Contato (mailto:) informado aos push services; vazio = ADMIN_EMAIL e,
# sem ele, o CLINIC_EMAIL da marca (sem nenhum dos três o push não sai).
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_CLAIMS_EMAIL=

# Segurança / retenção
# 2FA obrigatório p/ ADMIN: sem a env, ligado em prod e desligado no runserver.
# false = válvula de emergência (aviso aranha.W008 enquanto estiver assim).
# ADMIN_2FA_OBRIGATORIO=
# true = 2FA obrigatório também p/ PROFISSIONAL (lê prontuário/alertas de saúde)
# PROFISSIONAL_2FA_OBRIGATORIO=
# frame-ancestors das páginas embutíveis (vazio = qualquer origem https:)
# EMBED_FRAME_ANCESTORS=https://linktr.ee https://www.instagram.com
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_TIME_HOURS=1
# PASSWORD_RESET_TIMEOUT_SECONDS=3600
# Prazos LGPD (cliente inativa 5 anos, saúde 20 anos, pacote 5 anos, ficha sem atendimento 90 dias)
# NÃO vêm do ambiente: são os publicados na Política de Privacidade (settings.RETENCAO_*; mudar =
# nova versão do termo LGPD). LGPD_RETENCAO_CLIENTE_DIAS foi removida.
# RETENCAO_OTP_HORAS=24
# RETENCAO_NOTIFICACAO_DIAS=365
# RETENCAO_LOG_AUDITORIA_DIAS=1825
# RETENCAO_AXES_LOG_DIAS=90
# link publico vencido/revogado ha mais de N dias e apagado (housekeeping / sp_purgar_dados_expirados)
# RETENCAO_LINK_ACESSO_DIAS=90

# Observabilidade
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
# Ambiente e release no Sentry. Vazios: nome do ambiente no Railway (RAILWAY_ENVIRONMENT_NAME)
# e o commit do deploy (RAILWAY_GIT_COMMIT_SHA).
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# Nível do log do Django (padrão: INFO no dev, WARNING em prod/staging)
# DJANGO_LOG_LEVEL=INFO

# Testes no Postgres (CI): manage.py test usa este banco em vez do SQLite
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ci
