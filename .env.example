# Jaqueline Aranha Estética — variáveis de ambiente
# Dev local: copie para `.env` (DEBUG=True basta; o resto tem default).
# Produção (Railway): defina no serviço web. `manage.py check` lista o que falta
# em prod (avisos aranha.W001..W005).

# ═══════════════════════════════════════════════════════════════════
#  OBRIGATÓRIAS EM PRODUÇÃO
# ═══════════════════════════════════════════════════════════════════

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-essa-chave-em-producao

# DEBUG=True só em dev local. Em prod é sempre forçado para False (settings/prod.py).
DEBUG=True

# Hosts aceitos (vírgula). O Railway acrescenta RAILWAY_PUBLIC_DOMAIN e o host
# do healthcheck (healthcheck.railway.app) automaticamente.
ALLOWED_HOSTS=127.0.0.1,localhost
# Origens CSRF (https em prod). RAILWAY_PUBLIC_DOMAIN é acrescentado sozinho.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# URL pública absoluta, sem barra final — links de e-mail/WhatsApp/termos/JSON-LD.
# Sem ela, cai em https://$RAILWAY_PUBLIC_DOMAIN (ou localhost em dev).
SITE_URL=http://127.0.0.1:8000

# Postgres (o Railway injeta). Vazio em dev = SQLite (db_dev.sqlite3).
# DATABASE_URL=postgres://user:pass@localhost:5432/aranha_estetica_dev

# Token do cron externo: POST /cron/run/<job>/ com header X-Cron-Token (nunca ?token=).
CRON_TOKEN=

# SMS (OTP do agendamento, Meus Agendamentos, LGPD). Sem os dois, o envio falha
# fechado em prod e o site orienta o cliente a usar o WhatsApp.
ZENVIA_API_TOKEN=
ZENVIA_FROM=

# E-mail. Em prod, sem EMAIL_BACKEND nada é enviado (backend dummy); em dev o
# default é o console. SMTP: django.core.mail.backends.smtp.EmailBackend.
# SMTP de saída no Railway só no plano Pro; no Hobby use um provedor HTTP.
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
# Remetente de domínio verificado no provedor
DEFAULT_FROM_EMAIL=noreply@clinica.com.br

# Admin criado/atualizado no pre-deploy (manage.py bootstrap_admin). Sem os dois
# o comando não faz nada. A senha de um admin existente só é trocada se a conta
# estava desativada ou com ADMIN_PASSWORD_RESET=true. ADMIN_EMAIL também recebe
# alertas de NPS detrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=
ADMIN_PASSWORD_RESET=

# ═══════════════════════════════════════════════════════════════════
#  MARCA / CONTATOS (a tela Branding do painel tem precedência sobre a env)
#  Vazio = item escondido no site (nunca placeholder falso).
# ═══════════════════════════════════════════════════════════════════
CLINIC_NAME=Jaqueline Aranha Estética
CLINIC_SUBTITLE=
CLINIC_EMAIL=
CLINIC_PHONE=
CLINIC_ADDRESS=
CLINIC_HOURS=
# Só dígitos, com DDI (ex.: 5517991234567)
WHATSAPP_NUMERO=
INSTAGRAM_URL=
THEME_COLOR=

# ═══════════════════════════════════════════════════════════════════
#  OPCIONAIS
# ═══════════════════════════════════════════════════════════════════

# dev | prod. Vazio = dev local; prod quando RAILWAY_ENVIRONMENT_NAME existe.
DJANGO_ENV=dev
# Redirect p/ HTTPS em prod (default True)
USE_HTTPS=True

# IP do cliente: header escrito pelo proxy de borda. Prod default HTTP_X_REAL_IP
# (Railway); vazio em dev = REMOTE_ADDR. Nunca usar X-Forwarded-For (forjável).
# CLIENT_IP_HEADER=HTTP_X_REAL_IP

# Gunicorn (Dockerfile/railway.json). Mantenha 1 worker sem REDIS_URL.
# WEB_CONCURRENCY=1
# WEB_THREADS=4
# WEB_TIMEOUT=120

# Sessão da equipe em prod: 8h deslizantes (segundos)
# SESSION_COOKIE_AGE=28800

# Cache/sessão compartilhados entre workers (opcional). NÃO liga worker Celery.
REDIS_URL=
# Worker Celery (+ beat) só com CELERY_WORKER_ENABLED=true; senão tasks rodam
# eager e os jobs vêm do cron HTTP. Broker/result caem em REDIS_URL se vazios.
CELERY_WORKER_ENABLED=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Captcha (Cloudflare Turnstile) no agendamento público
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS — ajustes finos (defaults seguros)
# ZENVIA_API_URL=https://api.zenvia.com/v2/channels/sms/messages
# ZENVIA_WEBHOOK_SECRET=
# ZENVIA_ALLOWED_IPS=
# SMS_MAX_POR_HORA=3
# SMS_MAX_POR_IP_HORA=10
# SMS_MAX_GLOBAL_HORA=60
# true = só loga, não envia (dev/testes; nunca em prod)
# SMS_DEV_LOG_ONLY=

# OTP
# OTP_TTL_SEGUNDOS=600
# OTP_MAX_TENTATIVAS=5
# OTP_REENVIO_MINIMO_SEG=60

# WhatsApp Business API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_URL=
# WHATSAPP_API_VERSION=
# WHATSAPP_TEMPLATE_D1=confirmacao_d1
# WHATSAPP_TEMPLATE_NPS=nps_pos_atendimento
# WHATSAPP_TEMPLATE_LISTA_ESPERA=lista_espera_vaga

# Web Push (VAPID)
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_CLAIMS_EMAIL=

# Google Calendar (UI escondida sem estas chaves)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Storage S3/R2 opcional p/ mídia (exige django-storages instalado)
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=

# Segurança / retenção
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_TIME_HOURS=1
# PASSWORD_RESET_TIMEOUT_SECONDS=3600
# TWO_FACTOR_REMEMBER_COOKIE_AGE=2592000
# LGPD_RETENCAO_CLIENTE_DIAS=1825
# RETENCAO_OTP_HORAS=24
# RETENCAO_NOTIFICACAO_DIAS=365
# RETENCAO_LOG_AUDITORIA_DIAS=1825
# RETENCAO_AXES_LOG_DIAS=90

# Observabilidade
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
DJANGO_LOG_LEVEL=INFO

# Testes no Postgres (CI): manage.py test usa este banco em vez do SQLite
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ci
