{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/aranha_estetica/**",
      "/clinica/**",
      "/manage.py",
      "/requirements.txt",
      "/requirements.lock",
      "/package.json",
      "/package-lock.json",
      "/vite.config.js",
      "/Dockerfile",
      "/railway.json"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "preDeployCommand": [
      "sh -c 'python manage.py migrate_atomico --noinput && python manage.py bootstrap_admin'"
    ],
    "startCommand": "sh -c 'exec gunicorn clinica.wsgi --bind 0.0.0.0:${PORT:-8080} --workers ${WEB_CONCURRENCY:-1} --threads ${WEB_THREADS:-4} --timeout ${WEB_TIMEOUT:-120} --access-logfile - --error-logfile - --logger-class clinica.gunicorn_logger.LoggerSemTokens'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/healthz/",
    "healthcheckTimeout": 120
  },
  "environments": {
    "dev": {
      "deploy": {
        "preDeployCommand": [
          "sh -c 'python manage.py migrate_atomico --noinput && python manage.py bootstrap_admin && python manage.py seed --demo'"
        ]
      }
    }
  }
}
