@startuml 11-servicos-clinico-lgpd
' GERADO por docs/uml/gerar_uml.py a partir do codigo — nao edite a mao.
!include ../estilo.iuml
hide empty members
title Serviços — fichas, prontuário, termos e LGPD

class "services.anamnese" as anamnese <<módulo>> {
  + validar_respostas(schema, dados)
  + convidar(formulario, atendimento)
  + valida_desde(em)
  + fichas_em_dia(cliente, em)
  + fichas_pendentes(atendimento)
  + convite_pesquisa(atendimento)
}
class "services.alertas" as alertas <<módulo>> {
  + alertas_por_cliente(clientes)
  + ids_com_ficha_pendente(atendimentos)
  + marcar_atendimentos(atendimentos, *, valores)
  + registrar_leitura_saude(request, cliente_ids, tela)
}
class "services.prontuario" as prontuario <<módulo>> {
  + vinculo_clinico(profissional, cliente, *, escrita)
}
class "services.termos" as termos <<módulo>> {
  + q_termos_aplicaveis(procedimento_id)
  + vale_para(versao, procedimento)
  + termos_aplicaveis(procedimento)
  + termos_pendentes(cliente, procedimento, *, so_procedime…)
  + aceita_assinatura(atendimento)
  + ids_com_termo_procedimento_pendente(atendimentos)
  + url_termo(token)
  + obter_link_termo(atendimento, canal)
}
class "services.consentimentos" as consentimentos <<módulo>> {
  + ultimos(cliente)
  + estado_atual(cliente)
  + estado_wizard(cliente)
  + vigente(cliente, finalidade, canal)
  + anotar_vigente(qs, finalidade, canal, *, caminho, nome)
  + com_consentimento(qs, finalidade, canal, *, caminho)
  + registrar(cliente, finalidade, canal, concedido,…)
  + revogar(cliente, finalidade, canal, *, origem,…)
  + revogar_todos(cliente, *, origem, texto, pares, requ…)
  + registrar_do_wizard(cliente, marcados, *, sincronizados, c…)
  + historico(cliente)
  + resumo_painel(cliente)
  + par_da_chave(chave)
  + preferencias_portal(cliente)
  + registrar_do_portal(cliente, marcados, *, request)
  + saude_consentida(cliente)
  + revogar_saude(cliente, *, origem, request, usuario, …)
}
class "services.lgpd" as lgpd <<módulo>> {
  + prazos_retencao()
  + sobre_o_tratamento()
  + exportar_dados(cliente, *, incluir_saude)
}
class LgpdService <<serviço>> {
  + {static} exportar_dados_cliente()
  + {static} link_descadastro()
  + {static} cliente_por_token_descadastro()
  + {static} unsubscribe_por_token()
  + {static} esquecer_cliente()
  + {static} candidatos_retencao()
  + {static} aplicar_retencao()
}
lgpd *-- LgpdService
class "services.portal_cliente" as portal_cliente <<módulo>> {
  + abrir_sessao(request, telefone, *, verificado_em)
  + abrir_sessao_do_wizard(request, telefone)
  + telefone_da_sessao(request)
  + encerrar_sessao(request)
  + sessao_recente(request, janela)
  + clientes_da_sessao(request)
  + cliente_da_sessao(request)
  + atendimento_da_sessao(request, pk)
  + registrar_pedido(cliente, tipo, descricao, *, request)
}
class "services.fidelidade" as fidelidade #F2F2F2
hide fidelidade members
class "services.links" as links #F2F2F2
hide links members
class "services.nps" as nps #F2F2F2
hide nps members
class "services.otp" as otp #F2F2F2
hide otp members
class "services.pacotes" as pacotes #F2F2F2
hide pacotes members
alertas ..> anamnese
alertas ..> fidelidade
alertas ..> pacotes
alertas ..> termos
anamnese ..> links
portal_cliente ..> nps
portal_cliente ..> otp
termos ..> links
@enduml
