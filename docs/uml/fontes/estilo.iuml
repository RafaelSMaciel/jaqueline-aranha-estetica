' Estilo comum dos diagramas do sistema Jaqueline Aranha Estética: fundo branco e traco escuro (impressao e Word),
' acento dourado da marca. Incluido por todas as fontes (!include ../estilo.iuml).
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam defaultFontColor #1B1F23
skinparam shadowing false
skinparam roundCorner 8
skinparam dpi 110
skinparam ArrowColor #4A3425
skinparam ArrowFontSize 11
skinparam ArrowFontColor #4A3425
skinparam TitleFontSize 17
skinparam TitleFontStyle bold
skinparam TitleFontColor #4A3425
skinparam NoteBackgroundColor #FFF8E6
skinparam NoteBorderColor #C9A84C
skinparam NoteFontSize 11
skinparam LegendBackgroundColor #FFFDF7
skinparam LegendBorderColor #C9A84C
skinparam LegendFontSize 11
skinparam PackageBorderColor #8C6D23
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageFontColor #4A3425
skinparam RectangleBorderColor #8C6D23
skinparam RectangleFontColor #4A3425
skinparam ClassBackgroundColor #FFFDF7
skinparam ClassBorderColor #8C6D23
skinparam ClassHeaderBackgroundColor #F3E7C6
skinparam ClassAttributeIconSize 0
skinparam ActorBorderColor #4A3425
skinparam ActorBackgroundColor #FFF8E6
skinparam UsecaseBackgroundColor #FFFDF7
skinparam UsecaseBorderColor #8C6D23
skinparam ComponentBackgroundColor #FFFDF7
skinparam ComponentBorderColor #8C6D23
skinparam InterfaceBackgroundColor #F3E7C6
skinparam InterfaceBorderColor #8C6D23
skinparam NodeBackgroundColor #FFFDF7
skinparam NodeBorderColor #8C6D23
skinparam DatabaseBackgroundColor #FFFDF7
skinparam DatabaseBorderColor #8C6D23
skinparam CloudBackgroundColor #FBF6EA
skinparam CloudBorderColor #8C6D23
skinparam ArtifactBackgroundColor #FFFDF7
skinparam ArtifactBorderColor #8C6D23
skinparam StateBackgroundColor #FFFDF7
skinparam StateBorderColor #8C6D23
skinparam StateStartColor #4A3425
skinparam StateEndColor #4A3425
skinparam ActivityBackgroundColor #FFFDF7
skinparam ActivityBorderColor #8C6D23
skinparam ActivityDiamondBackgroundColor #F3E7C6
skinparam ActivityDiamondBorderColor #8C6D23
skinparam ActivityStartColor #4A3425
skinparam ActivityEndColor #4A3425
skinparam SwimlaneBorderColor #8C6D23
skinparam SwimlaneTitleFontColor #4A3425
skinparam SequenceLifeLineBorderColor #8C6D23
skinparam SequenceParticipantBackgroundColor #FFFDF7
skinparam SequenceParticipantBorderColor #8C6D23
skinparam SequenceActorBackgroundColor #FFF8E6
skinparam SequenceActorBorderColor #4A3425
skinparam SequenceGroupBorderColor #8C6D23
skinparam SequenceGroupHeaderFontColor #4A3425
skinparam SequenceBoxBackgroundColor #FBF6EA
skinparam SequenceBoxBorderColor #C9A84C
skinparam SequenceDividerBackgroundColor #F3E7C6
skinparam EntityBackgroundColor #FFFDF7
skinparam EntityBorderColor #8C6D23
