@startuml 05-lembrete-e-confirmacao
!include ../estilo.iuml
title Sequência — lembrete D-1 por WhatsApp e confirmação de presença
autonumber

actor "Agendador\n(cron)" as CR
participant "views.infra.cron" as VC
participant "jobs.job_enviar_\nlembrete_dia_seguinte" as J
participant "services\n.consentimentos" as CS
participant "services.links" as L
participant "WhatsApp\n(Meta Cloud API)" as WA
actor "Cliente" as C
participant "views.publico\n.confirmacao" as VP
participant "Atendimento" as AT
database "PostgreSQL" as DB

CR -> VC : POST /cron/run/lembrete_diario/\n(X-Cron-Token)
VC -> J : executar
J -> DB : AGENDADO de amanhã sem lembrete
J -> CS : com_consentimento(LEMBRETE, WHATSAPP)
loop cada atendimento de amanhã
  J -> L : emitir(CONFIRMAR_PRESENCA, expira no início)
  L -> DB : link_acesso (só o SHA-256 do token)
  alt autorizou WhatsApp
    J -> DB : Notificacao LEMBRETE WHATSAPP
    J -> WA : template confirmacao_d1 com /confirmar/<token>/
  else sem autorização e com e-mail
    J -> DB : Notificacao LEMBRETE EMAIL (fila; contrato, art. 7º V)
  end
end
VC -> VC : avisa o monitor (healthchecks)

C -> VP : abre o link (?acao=confirmar|cancelar)
VP -> L : resolver(token)
C -> VP : POST confirmar
group transaction.atomic
  VP -> DB : notificação e atendimento FOR UPDATE
  alt confirmar
    VP -> AT : confirmar() AGENDADO → CONFIRMADO
  else cancelar
    VP -> AT : cancelar(pela_cliente=True)
  end
  VP -> DB : notificação.resposta + link usado + auditoria (IP)
end
VP --> C : resposta registrada (uma só)
@enduml
