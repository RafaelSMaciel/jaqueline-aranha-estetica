@startuml 06-portal-profissional
!include ../estilo.iuml
left to right direction
title Casos de uso — portal da profissional

actor "Profissional" as P
actor "Cliente" as C <<notificada>>

rectangle "Portal da profissional (/profissional/)" {
  usecase "Entrar com senha + 2FA" as U1
  usecase "Ver a própria agenda\n(dia e semana)" as U2
  usecase "Aprovar ou recusar\nos próprios pedidos" as U3
  usecase "Marcar realizado" as U4
  usecase "Anotar a sessão" as U5
  usecase "Ver alertas de saúde\ne ficha pendente" as U6
  usecase "Gerar link da agenda (ICS)" as U7
  usecase "Receber push\n(novo, cancelou, remarcou,\nsem desfecho)" as U8
  usecase "Ver minhas comissões" as U9
}

P --> U1
U2 ..> U1 : <<include>>
P --> U2
P --> U3
P --> U4
P --> U5
P --> U6
P --> U7
P --> U8
P --> U9
U3 --> C : e-mail de confirmação\nou cancelamento
U4 ..> U6 : <<include>>
@enduml
