@startuml 02-site-publico
!include ../estilo.iuml
left to right direction
title Casos de uso — site público e agendamento online

actor "Visitante" as V
actor "SMS (Zenvia)" as SMS <<externo>>
actor "Profissional" as P

rectangle "Site público" {
  usecase "Consultar serviços,\npreços e promoções" as UC1
  usecase "Conhecer a equipe\ne depoimentos" as UC2
  usecase "Agendar online" as UC3
  usecase "Escolher procedimento" as UC3a
  usecase "Escolher profissional\ne horário livre" as UC3b
  usecase "Verificar o celular (OTP)" as UC3c
  usecase "Aceitar a Política de\nPrivacidade (LGPD)" as UC3d
  usecase "Responder a ficha\nde anamnese" as UC3e
  usecase "Aceitar o termo\ndo procedimento" as UC3f
  usecase "Autorizar comunicações\n(marketing, lembrete, NPS)" as UC3g
  usecase "Entrar na lista de espera" as UC4
  usecase "Pedir cópia dos meus dados\n(DSAR, com OTP)" as UC5
  usecase "Descadastrar-se do marketing" as UC6
  usecase "Falar pelo WhatsApp" as UC7
}

V --> UC1
V --> UC2
V --> UC3
V --> UC4
V --> UC5
V --> UC6
V --> UC7

UC3 ..> UC3a : <<include>>
UC3 ..> UC3b : <<include>>
UC3 ..> UC3c : <<include>>
UC3 ..> UC3d : <<include>>
UC3e ..> UC3 : <<extend>>\n(ficha aplicável\nao procedimento)
UC3f ..> UC3 : <<extend>>\n(procedimento\ncom termo)
UC3g ..> UC3 : <<extend>>
UC5 ..> UC3c : <<include>>
UC3c --> SMS
UC3 --> P : e-mail de aprovação\n(cliente nova)

note right of UC3
  Cliente de confiança (já atendida, sem falta em aberto,
  menos de 2 horários futuros) → AGENDADO com confirmação na hora.
  Primeira vez → PENDENTE: a profissional aprova.
  3 faltas seguidas bloqueiam o agendamento online.
end note
@enduml
