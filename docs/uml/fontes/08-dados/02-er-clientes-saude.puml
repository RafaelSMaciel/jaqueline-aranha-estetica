@startuml 02-er-clientes-saude
' GERADO por docs/uml/gerar_uml.py a partir dos models — nao edite a mao.
!include ../estilo.iuml
!include ../estilo-er.iuml
title Modelo de dados — Clientes, saúde e formulários

entity "cliente" as cliente {
  * <b>id</b> : bigint <<PK>>
  --
  * nome : varchar(150)
  data_nascimento : date
  cpf : varchar(11)
  email : varchar(254)
  telefone : varchar(20)
  cep : varchar(10)
  endereco : varchar(255)
  * eh_ativo : boolean
  * qtd_faltas_consecutivas : smallint
  * eh_bloqueado_online : boolean
  saude_revogada_em : timestamptz
  cliente_indicador_id : bigint <<FK>>
  codigo_indicacao : varchar(12)
  * created_at : timestamptz
  * updated_at : timestamptz
  deleted_at : timestamptz
}

entity "prontuario" as prontuario {
  * <b>id</b> : bigint <<PK>>
  --
  * cliente_id : bigint <<FK,UK>>
  * alergias : text
  * contraindicacoes : text
  * historico_saude : text
  * medicamentos_uso : text
  * observacoes_gerais : text
  * respostas : jsonb
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "prontuario_versao" as prontuario_versao {
  * <b>id</b> : bigint <<PK>>
  --
  * prontuario_id : bigint <<FK>>
  * dados : jsonb
  * created_at : timestamptz
  created_by_id : bigint <<FK>>
  * created_by_name : varchar(100)
}

entity "anotacao_sessao" as anotacao_sessao {
  * <b>id</b> : bigint <<PK>>
  --
  * atendimento_id : bigint <<FK>>
  * texto : text
  * created_at : timestamptz
  created_by_id : bigint <<FK>>
  * created_by_name : varchar(100)
}

entity "formulario" as formulario {
  * <b>id</b> : bigint <<PK>>
  --
  * nome : varchar(120)
  * tipo : varchar(12)
  * escopo : varchar(20)
  * categoria : varchar(20)
  procedimento_id : bigint <<FK>>
  * perguntas : jsonb
  * eh_ativo : boolean
  * eh_obrigatorio : boolean
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "resposta_formulario" as resposta_formulario {
  * <b>id</b> : bigint <<PK>>
  --
  * formulario_id : bigint <<FK>>
  * cliente_id : bigint <<FK>>
  atendimento_id : bigint <<FK>>
  * respostas : jsonb
  respondido_em : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "aceite_termo" as aceite_termo #F2F2F2 {
}

entity "atendimento" as atendimento #F2F2F2 {
}

entity "carteira" as carteira #F2F2F2 {
}

entity "compra_pacote" as compra_pacote #F2F2F2 {
}

entity "consentimento" as consentimento #F2F2F2 {
}

entity "link_acesso" as link_acesso #F2F2F2 {
}

entity "lista_espera" as lista_espera #F2F2F2 {
}

entity "procedimento" as procedimento #F2F2F2 {
}

entity "usuario" as usuario #F2F2F2 {
}

cliente |o--o{ cliente : cliente_indicador_id
cliente ||--o{ consentimento : cliente_id
cliente ||--o{ atendimento : cliente_id
cliente ||--o| prontuario : cliente_id
prontuario ||--o{ prontuario_versao : prontuario_id
usuario |o--o{ prontuario_versao : created_by_id
atendimento ||--o{ anotacao_sessao : atendimento_id
usuario |o--o{ anotacao_sessao : created_by_id
cliente ||--o{ aceite_termo : cliente_id
cliente ||--o{ compra_pacote : cliente_id
cliente |o--o{ lista_espera : cliente_id
procedimento |o--o{ formulario : procedimento_id
formulario ||--o{ resposta_formulario : formulario_id
cliente ||--o{ resposta_formulario : cliente_id
atendimento |o--o{ resposta_formulario : atendimento_id
resposta_formulario |o--o{ link_acesso : resposta_formulario_id
cliente |o--o{ link_acesso : cliente_id
cliente ||--o| carteira : cliente_id
@enduml
