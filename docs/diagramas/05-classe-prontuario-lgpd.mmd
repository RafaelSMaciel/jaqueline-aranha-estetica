---
title: Diagrama de Classes (UML) — Prontuário, Formulários, NPS, Termos, Consentimentos, Acesso e Trilhas
---
classDiagram
    direction LR

    class Cliente {
        «ref» núcleo de agendamento
    }
    class Atendimento {
        «ref» núcleo de agendamento
    }
    class Procedimento {
        «ref» núcleo de agendamento
    }
    class Profissional {
        «ref» núcleo de agendamento
    }
    class Notificacao {
        «ref» núcleo de agendamento
    }

    class Prontuario {
        +alergias: TextoCifrado
        +contraindicacoes: TextoCifrado
        +historico_saude: TextoCifrado
        +medicamentos_uso: TextoCifrado
        +observacoes_gerais: TextoCifrado
        +respostas_extras: JsonCifrado «formulário PRONTUARIO»
    }
    class ProntuarioVersao {
        +dados: JsonCifrado «foto anterior»
        +autor_nome: CharField
        +criado_em: DateTime
        «append-only, imutável por trigger»
        +registrar(prontuario, usuario)$
    }
    class AnotacaoSessao {
        +texto: TextoCifrado
        +autor_nome: CharField
        +criado_em: DateTime
        «append-only: correção = nova anotação»
    }
    class FormularioAnamnese {
        +nome: CharField
        +tipo: ANAMNESE|PESQUISA|PRONTUARIO
        +escopo: GLOBAL|CATEGORIA|PROCEDIMENTO|MODALIDADE
        +schema_json: JSON «perguntas, alerta_saude»
        +obrigatorio: Boolean
        «no máximo 1 PRONTUARIO ativo, global»
    }
    class RespostaAnamnese {
        +respostas_json: JsonCifrado «objeto»
        +respondida_em: DateTime
    }
    class AvaliacaoNPS {
        +nota: 0..10 «CHECK»
        +comentario: Text
        +autoriza_publicacao: Boolean «opt-in»
        +aprovado_publicacao: Boolean «moderação»
        +alerta_enviado: Boolean
    }
    class ListaEspera {
        +data_desejada: Date
        +turno_desejado: MANHA|TARDE|NOITE
        +email_contato: EmailField «só da inscrição»
        +notificado: Boolean
    }
    class Usuario {
        +papel: ADMIN|PROFISSIONAL|RECEPCAO
        +email: «USERNAME_FIELD»
        +ativo: Boolean
        +is_staff: papel == ADMIN
    }
    class CodigoOtp {
        +telefone: CharField
        +codigo_hash: HMAC-SHA256
        +proposito: AGENDAMENTO|LOGIN_CLIENTE|DSAR
        +expira_em: DateTime «10 min»
        +tentativas: 0..5
        +gerar_sms() verificar_sms()
    }
    class VersaoTermo {
        +tipo: LGPD|SAUDE|PROCEDIMENTO
        +titulo / conteudo / versao
        +vigente_desde: Date
        +ativa: Boolean «1 ativa por escopo»
        «imutável após o 1º aceite»
        +lgpd_vigente()$
        +saude_vigente()$
    }
    class AceiteTermo {
        +ip: GenericIP
        +user_agent: CharField
        +conteudo_sha256: char64
        +criado_em: DateTime
        «prova legal, imutável por trigger»
        +registrar(cliente, versao, request, atendimento)$
    }
    class Consentimento {
        +finalidade: MARKETING|LEMBRETE_AGENDAMENTO|PESQUISA_SATISFACAO
        +canal: EMAIL|WHATSAPP
        +concedido: Boolean
        +origem: AGENDAMENTO_ONLINE|DESCADASTRO|PAINEL|ESQUECIMENTO|...
        +texto / ip_origem / user_agent
        +registrado_em: DateTime
        «histórico append-only: vale o mais recente»
    }
    class LinkAcesso {
        +finalidade: CONFIRMAR_PRESENCA|NPS|TERMO|FORMULARIO|DESCADASTRO|FEED_ICS|...
        +token_hash: char64 «SHA-256, único»
        +expira_em / usado_em / revogado_em
        «exatamente 1 alvo»
    }
    class LogAuditoria {
        +usuario_nome: CharField «snapshot»
        +acao: Text
        +tabela / registro_id
        +detalhes: JSON «PII mascarada»
        +ip_origem: GenericIP
        «append-only no banco»
    }
    class HistoricoAlteracao {
        +tabela / registro_pk
        +operacao: INSERT|UPDATE|DELETE
        +colunas_alteradas: JSON
        +dados_antes / dados_depois: JSON
        +ip_origem / origem / transacao_ref
        «gravada por trigger, append-only»
    }
    class AssinaturaPush {
        +endpoint: URL «único»
        +p256dh / auth: VAPID
        +ativo: Boolean
    }

    Cliente "1" --> "0..1" Prontuario : O2O - PROTECT
    Prontuario "1" --> "0..*" ProntuarioVersao : versoes
    Usuario "0..1" --> "0..*" ProntuarioVersao : autor
    Cliente "1" --> "0..*" RespostaAnamnese
    FormularioAnamnese "1" --> "0..*" RespostaAnamnese
    Atendimento "0..1" --> "0..*" RespostaAnamnese
    Atendimento "1" --> "0..*" AnotacaoSessao : anotacoes
    Usuario "0..1" --> "0..*" AnotacaoSessao : autor - PROTECT
    Atendimento "1" --> "0..1" AvaliacaoNPS : O2O
    Cliente "1" --> "0..*" ListaEspera
    Usuario "0..1" --> "0..1" Profissional : O2O
    Cliente "1" --> "0..*" AceiteTermo : aceites - PROTECT
    VersaoTermo "1" --> "0..*" AceiteTermo
    Atendimento "0..1" --> "0..*" AceiteTermo
    Procedimento "0..1" --> "0..*" VersaoTermo
    Cliente "1" --> "0..*" Consentimento : histórico - PROTECT
    Usuario "0..1" --> "0..*" Consentimento : autor
    LinkAcesso "0..*" --> "0..1" Atendimento : alvo
    LinkAcesso "0..*" --> "0..1" Notificacao : alvo
    LinkAcesso "0..*" --> "0..1" RespostaAnamnese : alvo
    LinkAcesso "0..*" --> "0..1" Cliente : alvo
    LinkAcesso "0..*" --> "0..1" Profissional : alvo
    Usuario "0..1" --> "0..*" LogAuditoria
    Usuario "0..1" --> "0..*" HistoricoAlteracao : autor da sessão
    Usuario "1" --> "0..*" AssinaturaPush
