---
title: Diagrama de Classes (UML) — Núcleo de Agendamento
---
classDiagram
    direction LR

    class Cliente {
        +nome: CharField «collation pt_br»
        +telefone: CharField «só dígitos, único entre ativas»
        +email: EmailField «opcional, único entre ativas»
        +cpf: CharField «opcional, único entre ativas»
        +data_nascimento: Date
        +faltas_consecutivas: Smallint
        +bloqueado_online: Boolean
        +codigo_indicacao: CharField «único»
        +deletado_em: DateTime «soft delete»
        +registrar_falta()
        +resetar_faltas()
        +soft_delete()
    }
    class Profissional {
        +nome: CharField
        +slug: SlugField «único»
        +ativo: Boolean
        +min_notice_horas: 0..720 «padrão 2»
        +max_advance_dias: 1..365 «padrão 60»
        +gcal_refresh_token: TextoCifrado
    }
    class AgendaHorario {
        +dia_semana: 1..7 «ISO, 1 = segunda»
        +hora_inicio / hora_fim: Time
        «EXCLUDE: janelas sem sobreposição»
    }
    class AgendaExcecao {
        +tipo: FOLGA | HORARIO_DIFERENTE | BLOQUEIO
        +origem: MANUAL | FERIADO_NACIONAL | FERIADO_LOCAL | RECESSO | GCAL
        +data_inicio / data_fim: Date «FOLGA»
        +hora_inicio / hora_fim: Time «HORARIO_DIFERENTE»
        +data_hora_inicio / data_hora_fim «BLOQUEIO»
        +regra_recorrencia: RRULE DAILY|WEEKLY|MONTHLY
        +ativo: Boolean
        «profissional nulo = clínica inteira»
        +ocorrencias(inicio, fim)
    }
    class Procedimento {
        +nome: CharField
        +duracao_minutos: Smallint
        +buffer_minutos: 0..120 «intervalo após»
        +categoria / modalidade: choices
        +exige_retorno: Boolean
        +retorno_minimo_dias / retorno_maximo_dias
        +duracao_retorno_minutos «padrão 30»
    }
    class Habilitacao {
        «through» profissional × procedimento
    }
    class Preco {
        +valor: Decimal «>= 0»
        +vigente_desde: Date «data local»
    }
    class Promocao {
        +desconto_percentual: 0..100
        +preco_promocional: Decimal «XOR desconto»
        +data_inicio / data_fim: Date
        +ativa: Boolean
        «geral = só percentual»
        +esta_vigente: bool
    }
    class Atendimento {
        +data_hora_inicio / data_hora_fim
        +status: FSM de 7 estados
        +valor_cobrado / valor_original: Decimal
        +descricao_preco: Text
        +eh_retorno: Boolean
        «EXCLUDE: sem sobreposição por profissional»
        +aprovar() confirmar() cancelar()
        +marcar_realizado() marcar_falta()
        +marcar_reagendado()
    }
    class Notificacao {
        +tipo: LEMBRETE|CONFIRMACAO|CANCELAMENTO|NPS|APROVACAO|TERMO|...
        +canal: WHATSAPP|EMAIL|SMS
        +status: PENDENTE|ENVIADO|FALHOU
        +tentativas / proxima_tentativa_em «fila de e-mail»
        +resposta: CONFIRMOU|CANCELOU
    }
    class SlotService {
        «service»
        +INTERVALO = 30 min
        +slots_livres(profissional, dia, procedimento)
        +slot_disponivel(profissional, procedimento, inicio)
    }
    class AgendaService {
        «service» services/agenda
        +validar_horario(profissional, procedimento, inicio)
        +reservar(cliente, profissional, procedimento, inicio, status)
        +reagendar(antigo, novo_inicio, profissional)
        +mover(atendimento_id, novo_inicio)
    }
    class AtendimentoService {
        «service» services/atendimento
        +ao_criar(atendimento)
        +ao_mudar_status(atendimento, anterior, novo)
    }

    Cliente "1" --> "0..*" Atendimento : agenda
    Cliente ..> Cliente : indicado_por 0..1
    Profissional "1" --> "0..*" Atendimento : atende
    Procedimento "1" --> "0..*" Atendimento
    Promocao "0..1" --> "0..*" Atendimento : preço da data
    Atendimento ..> Atendimento : reagendado_de / atendimento_origem
    Atendimento "1" --> "0..*" Notificacao
    Profissional "1" --> "0..*" AgendaHorario : grade
    Profissional "0..1" --> "0..*" AgendaExcecao : exceções
    Procedimento "1" --> "0..*" Preco
    Profissional "0..1" --> "0..*" Preco
    Promocao "0..*" --> "0..1" Procedimento
    Profissional "0..*" -- "0..*" Procedimento : Habilitacao
    SlotService ..> AgendaHorario : lê
    SlotService ..> AgendaExcecao : lê
    SlotService ..> Atendimento : ocupados
    AgendaService ..> SlotService : valida
    AgendaService ..> Atendimento : cria / reagenda / move
    AgendaService ..> AtendimentoService : ao_criar
    Atendimento ..> AtendimentoService : FSM chama ao_mudar_status
