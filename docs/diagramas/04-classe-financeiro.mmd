---
title: Diagrama de Classes (UML) — Pacotes, Carteira, Fidelidade e Comissão
---
classDiagram
    direction LR

    class Cliente {
        «ref» núcleo de agendamento
    }
    class Atendimento {
        «ref» núcleo de agendamento
    }
    class Procedimento {
        «ref» núcleo de agendamento
    }
    class Profissional {
        «ref» núcleo de agendamento
    }
    class Usuario {
        «ref» acesso
    }

    class Pacote {
        +nome: CharField
        +preco_total: Decimal
        +validade_meses: Smallint
        +ativo: Boolean
        «catálogo: editável, vale p/ vendas futuras»
    }
    class ItemPacote {
        +quantidade_sessoes: Smallint «>0»
    }
    class CompraPacote {
        +pacote_nome: CharField «congelado»
        +valor_pago: Decimal «>= 0»
        +valor_reembolsado: Decimal «0..valor_pago»
        +status: ATIVO|FINALIZADO|CANCELADO|EXPIRADO
        +data_expiracao: Date
        +vender(pacote, cliente, valor_pago)$
        +saldo_por_procedimento()
        +sessoes_restantes()
        +verificar_finalizacao()
    }
    class CompraPacoteItem {
        +procedimento_nome: CharField
        +quantidade_sessoes: Smallint «>0»
        +valor_unitario: Decimal «valor pago ÷ sessões»
        «snapshot da venda, imutável por trigger»
    }
    class ConsumoSessao {
        +criado_em: DateTime
        «1 por atendimento, O2O»
        «mesma compra, mesmo procedimento, com saldo»
    }
    class Carteira {
        +saldo: Decimal «CHECK >= 0»
    }
    class MovimentoCarteira {
        +tipo: CREDITO|DEBITO
        +origem: CASHBACK_INDICACAO|CASHBACK_ESTORNO|...
        +valor: Decimal «> 0»
        +saldo_resultante: Decimal «>= 0»
        «ledger imutável por trigger»
    }
    class RegraComissao {
        +percentual: 0..100
        +valor: Decimal «valor fixo»
        «percentual XOR valor fixo»
        +ativo: Boolean «usada = só desativa»
    }
    class MovimentoComissao {
        +tipo: CREDITO|PAGAMENTO|ESTORNO
        +valor: Decimal «> 0»
        +status: PENDENTE|PAGA|ESTORNADA «derivado»
        «livro-razão append-only»
        «1 CREDITO por atendimento»
    }
    class ComissaoService {
        «service»
        +resolver_regra(profissional, procedimento)$
        +calcular_comissao(atendimento)$
        +marcar_paga(movimento, usuario)$
        +estornar_comissao(atendimento)$
        +saldos_por_profissional()$
    }

    Pacote "1" --> "1..*" ItemPacote : itens do catálogo
    ItemPacote "0..*" --> "1" Procedimento
    Cliente "1" --> "0..*" CompraPacote : pacotes_comprados - PROTECT
    Pacote "1" --> "0..*" CompraPacote : vendido como
    CompraPacote "1" --> "1..*" CompraPacoteItem : itens congelados
    CompraPacoteItem "0..*" --> "1" Procedimento
    CompraPacoteItem "1" --> "0..*" ConsumoSessao : consumos
    ConsumoSessao "0..1" --> "1" Atendimento : O2O

    Cliente "1" --> "0..1" Carteira : O2O - PROTECT
    Carteira "1" --> "0..*" MovimentoCarteira : movimentos
    MovimentoCarteira "0..*" --> "0..1" Atendimento

    RegraComissao "0..*" --> "0..1" Profissional
    RegraComissao "0..*" --> "0..1" Procedimento
    Profissional "1" --> "0..*" MovimentoComissao : comissoes
    Atendimento "1" --> "0..*" MovimentoComissao
    MovimentoComissao "0..*" --> "0..1" RegraComissao : só no CREDITO
    MovimentoComissao ..> MovimentoComissao : PAGAMENTO/ESTORNO → CREDITO
    Usuario "0..1" --> "0..*" MovimentoComissao : autor
    ComissaoService ..> MovimentoComissao : lança
    ComissaoService ..> RegraComissao : mais específica
    ComissaoService ..> CompraPacoteItem : base da sessão de pacote
